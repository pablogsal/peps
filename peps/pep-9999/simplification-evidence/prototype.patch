--- /dev/null
+++ b/Tools/assert_details/check_plain.py
@@ -0,0 +1,39 @@
+"""Emit stable code signatures for plain assertions on two interpreter builds."""
+import ast
+import dis
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import types
+
+
+def signature(code):
+    return {
+        'bytecode': [(i.opname, i.arg) for i in dis.get_instructions(code, show_caches=True)],
+        'exceptions': code.co_exceptiontable.hex(),
+        'locations': code.co_linetable.hex(),
+        'locals': code.co_varnames,
+        'names': code.co_names,
+        'cells': code.co_cellvars,
+        'free': code.co_freevars,
+        'flags': code.co_flags,
+        'stack': code.co_stacksize,
+        'consts': [signature(c) if isinstance(c, types.CodeType)
+                   else (type(c).__name__, repr(c)) for c in code.co_consts],
+    }
+
+
+paths = subprocess.check_output(['git', 'ls-files', 'Lib'], text=True).splitlines()
+results = {}
+for name in paths:
+    path = Path(name)
+    if path.suffix != '.py' or any(p.startswith('test') or p.endswith('_test') for p in path.parts[1:-1]):
+        continue
+    source = path.read_bytes()
+    if not any(isinstance(n, ast.Assert) for n in ast.walk(ast.parse(source, name))):
+        continue
+    code = compile(source, name, 'exec', dont_inherit=True)
+    data = json.dumps(signature(code), sort_keys=True).encode()
+    results[name] = hashlib.sha256(data).hexdigest()
+print(json.dumps(results, indent=2, sort_keys=True))
diff --git a/Tools/assert_details/corpus.py b/Tools/assert_details/corpus.py
new file mode 100644
index 00000000000..9ff8feecd55
--- /dev/null
+++ b/Tools/assert_details/corpus.py
@@ -0,0 +1,70 @@
+"""Compare code size and compile time on assertion-bearing library modules."""
+import argparse
+import ast
+import json
+import marshal
+from pathlib import Path
+import statistics
+import subprocess
+import time
+import types
+
+
+def code_totals(code):
+    result = dict(code_objects=1, bytecode_bytes=len(code.co_code),
+                  exception_table_bytes=len(code.co_exceptiontable),
+                  location_table_bytes=len(code.co_linetable),
+                  locals=code.co_nlocals, stacksize=code.co_stacksize)
+    for value in code.co_consts:
+        if isinstance(value, types.CodeType):
+            for key, count in code_totals(value).items():
+                result[key] += count
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    paths = subprocess.check_output(['git', 'ls-files', 'Lib'], text=True).splitlines()
+    sources = []
+    for name in paths:
+        path = Path(name)
+        if path.suffix != '.py' or any(p.startswith('test') or p.endswith('_test') for p in path.parts[1:-1]):
+            continue
+        source = path.read_bytes()
+        tree = ast.parse(source, name)
+        count = sum(isinstance(node, ast.Assert) for node in ast.walk(tree))
+        if count:
+            sources.append((name, source, count))
+    rows = []
+    totals = {mode: {} for mode in ('plain', 'native')}
+    for name, source, count in sources:
+        row = {'file': name, 'assertions': count}
+        for mode, flags in [('plain', 0), ('native', ast.PyCF_ASSERT_DETAILS)]:
+            code = compile(source, name, 'exec', flags=flags, dont_inherit=True)
+            sizes = code_totals(code)
+            sizes['marshal_bytes'] = len(marshal.dumps(code))
+            row[mode] = sizes
+            for key, value in sizes.items():
+                totals[mode][key] = totals[mode].get(key, 0) + value
+        rows.append(row)
+    times = {'plain': [], 'native': []}
+    for trial in range(8):
+        order = [('plain', 0), ('native', ast.PyCF_ASSERT_DETAILS)]
+        if trial % 2:
+            order.reverse()
+        for mode, flags in order:
+            start = time.perf_counter()
+            for name, source, _ in sources:
+                compile(source, name, 'exec', flags=flags, dont_inherit=True)
+            times[mode].append(time.perf_counter() - start)
+    result = dict(files=len(rows), assertions=sum(r['assertions'] for r in rows),
+                  totals=totals, compile_seconds=times,
+                  compile_median={k: statistics.median(v) for k,v in times.items()}, rows=rows)
+    args.output.write_text(json.dumps(result, indent=2))
+    print(json.dumps({k: v for k,v in result.items() if k != 'rows'}, indent=2))
+
+
+if __name__ == '__main__':
+    main()
