diff --git a/Tools/assert_details/pytest_native.py b/Tools/assert_details/pytest_native.py
new file mode 100644
index 00000000000..1857616eea4
--- /dev/null
+++ b/Tools/assert_details/pytest_native.py
@@ -0,0 +1,75 @@
+"""Experimental pytest adapter. Load with ``-p pytest_native``.
+
+This adapter replaces pytest's compiler entry point. Its import selection,
+plugin hooks, and report machinery remain in pytest. It requires this CPython
+prototype and uses private pytest interfaces only at the loader boundary.
+"""
+
+import ast
+import importlib.util
+import sys
+
+import assertionlib
+import pytest
+from _pytest.assertion import rewrite, truncate
+
+_original_compile = rewrite._rewrite_test
+_original_tail = rewrite.PYC_TAIL
+
+
+def _compile_test(path, config):
+    source = path.read_bytes()
+    code = compile(source, str(path), 'exec', flags=ast.PyCF_ASSERT_DETAILS,
+                   dont_inherit=True, optimize=0)
+    return importlib.util.source_hash(source), code
+
+
+@pytest.hookimpl(tryfirst=True)
+def pytest_load_initial_conftests(early_config):
+    if early_config.getini('enable_assertion_pass_hook'):
+        raise pytest.UsageError('native assertion capture supports failure callbacks only')
+    rewrite._rewrite_test = _compile_test
+    rewrite.PYC_TAIL = (
+        f'.{sys.implementation.cache_tag}-pytest-native-v2{rewrite.PYC_EXT}'
+    )
+
+
+def pytest_unconfigure(config):
+    rewrite._rewrite_test = _original_compile
+    rewrite.PYC_TAIL = _original_tail
+
+
+def _message(error, details, compare=None):
+    explanation = ''.join(assertionlib.format_details(details, compare=compare)).strip()
+    if error.args:
+        explanation = f'{str(error)}\n{explanation}'
+    error.args = (explanation,)
+    # Pytest displays this explanation through format_exception_only().
+    # Keep captures for plugins, but omit a second, default explanation.
+    error._assertion_explained = True
+
+
+@pytest.hookimpl(wrapper=True)
+def pytest_collection(session):
+    with assertionlib.handlers(on_failure=_message):
+        return (yield)
+
+
+@pytest.hookimpl(wrapper=True)
+def pytest_runtest_protocol(item):
+    def compare(op, left, right):
+        results = item.ihook.pytest_assertrepr_compare(
+            config=item.config, op=op, left=left, right=right,
+        )
+        for result in results:
+            if result:
+                lines = truncate.materialize_with_truncation(result, item.config)
+                if lines:
+                    return [line.replace('\n', '\\n') for line in lines]
+        return None
+
+    def failure(error, details):
+        _message(error, details, compare)
+
+    with assertionlib.handlers(on_failure=failure):
+        return (yield)
diff --git a/Tools/assert_details/pytest_smoke.py b/Tools/assert_details/pytest_smoke.py
new file mode 100644
index 00000000000..4b6377b7cf1
--- /dev/null
+++ b/Tools/assert_details/pytest_smoke.py
@@ -0,0 +1,106 @@
+"""Exercise the optional pytest adapter in isolated subprocesses."""
+
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+
+HELPER = '''
+class Box:
+    def __init__(self, value): self.value = value
+    def __eq__(self, other): return self.value == other.value
+
+def check(left, right):
+    "helper docstring"
+    assert left == right
+'''
+
+CONFTEST = '''
+import pytest
+pytest.register_assert_rewrite('native_helper')
+from native_helper import Box
+
+def pytest_assertrepr_compare(config, op, left, right):
+    if isinstance(left, Box) and isinstance(right, Box):
+        return [f'custom boxes: {left.value} {op} {right.value}']
+'''
+
+TESTS = '''
+import dis
+import sys
+import pytest
+import assertionlib
+from native_helper import Box, check
+
+def test_caught_message():
+    with pytest.raises(AssertionError, match='custom boxes: 1 == 2') as caught:
+        assert Box(1) == Box(2)
+    assert assertionlib.get_details(caught.value) is not None
+
+def test_registered_helper():
+    with pytest.raises(AssertionError, match='custom boxes: 3 == 4'):
+        check(Box(3), Box(4))
+
+def test_compiler_backend():
+    names = {i.opname for i in dis.get_instructions(check)}
+    assert 'CALL_INTRINSIC_2' in names
+    assert check.__doc__ == 'helper docstring'
+    assert not any(name.startswith('@pytest') for name in check.__globals__)
+
+def test_pass_and_debug():
+    assert 2 == 2
+    assert __debug__
+
+def test_evaluation_once():
+    events = []
+    class Flag:
+        def __bool__(self):
+            events.append('bool')
+            return False
+    with pytest.raises(AssertionError):
+        assert Flag() and events.append('skipped')
+    assert events == ['bool']
+
+def test_report():
+    assert Box(10) == Box(20)
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--pytest-source', type=Path, required=True)
+    parser.add_argument('--pytest-deps', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=True)
+    env = os.environ.copy()
+    env['PYTEST_DISABLE_PLUGIN_AUTOLOAD'] = '1'
+    env['PYTHONPATH'] = os.pathsep.join(map(str, (
+        Path(__file__).resolve().parent, args.pytest_source / 'src', args.pytest_deps,
+    )))
+    with tempfile.TemporaryDirectory() as directory:
+        directory = Path(directory)
+        for name, source in [('native_helper.py', HELPER), ('conftest.py', CONFTEST),
+                             ('test_native.py', TESTS)]:
+            (directory / name).write_text(source)
+        for index, optimize in enumerate(('', '-O', '-OO', '')):
+            command = [sys.executable]
+            if optimize:
+                command.append(optimize)
+            command += ['-m', 'pytest', '-p', 'pytest_native', '-q']
+            result = subprocess.run(command, cwd=directory, env=env,
+                                    text=True, stdout=subprocess.PIPE,
+                                    stderr=subprocess.STDOUT)
+            (args.output / f'pytest-{index}.log').write_text(result.stdout)
+            if (result.returncode != 1 or '1 failed, 5 passed' not in result.stdout or
+                    'custom boxes: 10 == 20' not in result.stdout or
+                    '<native_helper.Box object' in result.stdout):
+                raise RuntimeError(f'pytest integration failed: {command}\n{result.stdout}')
+            print(f'{optimize or "normal"}: expected report and hooks passed', flush=True)
+
+
+if __name__ == '__main__':
+    main()
